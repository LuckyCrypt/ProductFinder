@using Shop.Models.Account;
@model AccountViewModel
@{
    Layout = null;
    var isVisibleRegisterTab = Model?.RegisterViewModel != null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Авторизация - LuckyCatalog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/widlanex.css" asp-append-version="true" />
    <style>
        /* Автономная страница входа — нейтрализуем стили фикс-шапки основного макета */
        body { padding-top: 0 !important; background: var(--bg-secondary); }
        .card { border: 1px solid var(--border-color); border-radius: var(--radius); box-shadow: var(--shadow-deep); background: var(--card-bg); }
        .card-header { background: transparent; border-bottom: 1px solid var(--border-color); }
        .card-header .text-primary { color: var(--accent) !important; }
        .nav-pills .nav-link { color: var(--text-secondary); font-weight: 700; border-radius: 10px; }
        .nav-pills .nav-link.active { background: var(--accent-grad); color: #fff; }
        main > footer.footer { background: transparent; color: var(--text-muted); margin-top: 12px; padding: 0; }
        main > footer.footer a { color: var(--text-muted); }
    </style>
</head>
<body>
    <div class="container-fluid d-flex align-items-center justify-content-center flex-column" style="min-height: 100vh;">
        <main role="main" style="width:400px" class="mt-5">
            <div class="card">
                <div class="card-header d-flex justify-content-center">
                    <span class="text-primary fw-bold" style="font-size: 25px">
                        <i class="fa-solid fa-magnifying-glass-dollar"></i> LuckyCatalog
                    </span>
                </div>
                <div class="card-body ps-5 pe-4">
                    <ul class="nav nav-pills nav-justified mb-3" id="ex1" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button
                                class="nav-link @(!isVisibleRegisterTab ? "active" : "")"
                                id="tab-Login"
                                data-bs-toggle="pill"
                                data-bs-target="#pills-login"
                                role="tab"
                                aria-controls="pills-login"
                                aria-selected="@(!isVisibleRegisterTab ? "true" : "false")"
                            >
                                Вход
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(isVisibleRegisterTab ? "active" : "")"
                                id="tab-Register"
                                data-bs-toggle="pill"
                                data-bs-target="#pills-register"
                                role="tab"
                                aria-controls="pills-register"
                                aria-selected="@(isVisibleRegisterTab ? "true" : "false")"
                            >
                                Регистрация
                            </button>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div class="tab-pane fade @(!isVisibleRegisterTab ? "show active" : "")" id="pills-login" role="tabpanel">
                           @{
                                ViewData.TemplateInfo.HtmlFieldPrefix = "l";
                                await Html.RenderPartialAsync("_Login", Model?.LoginViewModel);
                           }
                        </div>
                        <div class="tab-pane fade @(isVisibleRegisterTab ? "show active" : "")" id="pills-register" role="tabpanel">
                            @{
                                ViewData.TemplateInfo.HtmlFieldPrefix = "r";
                                await Html.RenderPartialAsync("_Register", Model?.RegisterViewModel);
                            }
                        </div>
                    </div>
                </div>
            </div>
            <footer class="footer text-end mt-3">
                &copy;@DateTime.Now.Year - LuckyCatalog
            </footer>
        </main>
    </div>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>
