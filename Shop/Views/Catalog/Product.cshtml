@model Shop.Domain.Entities.Product
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
    var offers = Model.Offers.OrderBy(o => o.Price).ToList();
}

<div class="product-page">
    <a class="back-link" href="javascript:history.back()">← Назад к списку</a>

    <div class="product-top">
        <div class="product-image">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/img/placeholder-phone-1.png" : Model.ImageUrl)" alt="@Model.Name">
        </div>
        <div class="product-info">
            <h1>@Model.Name</h1>
            @if (!string.IsNullOrEmpty(Model.Brand)) { <p class="brand">@Model.Brand@(Model.Year.HasValue ? $" · {Model.Year}" : "")</p> }
            @if (Model.PriceMin.HasValue)
            {
                <div class="price-range">
                    от <b>@Model.PriceMin.Value.ToString("N0")</b>
                    @if (Model.PriceMax.HasValue && Model.PriceMax != Model.PriceMin) { <text>до <b>@Model.PriceMax.Value.ToString("N0")</b></text> }
                    грн
                </div>
            }

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var isFav = ViewBag.IsFavorite == true;
                <form asp-controller="Cabinet" asp-action="ToggleFavorite" method="post" style="margin-bottom:16px">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                    <button type="submit" class="fav-btn @(isFav ? "on" : "")">
                        @(isFav ? "♥ В избранном" : "♡ В избранное")
                    </button>
                </form>
            }

            <h3>Предложения магазинов</h3>
            <table class="offers-table">
                <thead><tr><th>Магазин</th><th>Наличие</th><th>Цена</th><th></th></tr></thead>
                <tbody>
                @foreach (var o in offers)
                {
                    <tr>
                        <td>@o.Store?.Name</td>
                        <td>@(o.InStock ? "в наличии" : "нет")</td>
                        <td class="price">@o.Price.ToString("N0") грн</td>
                        <td><a class="go-btn" href="@o.ProductUrl" target="_blank" rel="noopener nofollow">Перейти</a></td>
                    </tr>
                }
                @if (!offers.Any())
                {
                    <tr><td colspan="4">Предложений пока нет.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Specifications.Any())
    {
        <h3>Характеристики</h3>
        <table class="spec-table">
            @foreach (var g in Model.Specifications.GroupBy(s => s.Group))
            {
                if (!string.IsNullOrEmpty(g.Key)) { <tr class="spec-group"><td colspan="2">@g.Key</td></tr> }
                foreach (var s in g)
                {
                    <tr><td class="spec-name">@s.Name</td><td>@s.Value</td></tr>
                }
            }
        </table>
    }
</div>

<style>
    .product-page{padding:20px 0;max-width:1000px;margin:0 auto}
    .back-link{color:var(--text-secondary);text-decoration:none;font-size:14px;font-weight:600}
    .back-link:hover{color:var(--accent)}
    .product-top{display:flex;gap:32px;margin-top:20px;flex-wrap:wrap}
    .product-image{width:340px;flex-shrink:0;background:linear-gradient(180deg,var(--card-grad-b),var(--card-grad-a));border:1px solid var(--border-color);border-radius:var(--radius,14px);padding:24px;display:flex;align-items:center;justify-content:center}
    .product-image img{width:100%;border-radius:8px;object-fit:contain}
    .product-info{flex:1;min-width:300px}
    .product-info h1{margin:0 0 6px;font-size:28px;font-weight:800;letter-spacing:-.5px;color:var(--text-primary)}
    .product-info .brand{color:var(--text-muted);margin:0 0 16px;font-weight:600}
    .price-range{color:var(--text-primary);font-weight:800;font-size:26px;margin-bottom:18px}
    .fav-btn{background:none;border:1px solid var(--border-color);border-radius:20px;padding:8px 18px;font-size:14px;font-weight:600;cursor:pointer;color:var(--text-secondary);transition:all .2s ease}
    .fav-btn.on{color:#fff;background:var(--accent);border-color:var(--accent)}
    .fav-btn:hover{border-color:var(--accent);color:var(--accent)}
    .fav-btn.on:hover{color:#fff}
    .product-info h3,.product-page > h3{margin-top:28px;margin-bottom:12px;font-size:18px;font-weight:800;color:var(--text-primary);padding-bottom:8px;border-bottom:2px solid var(--border-color)}
    .offers-table,.spec-table{width:100%;border-collapse:collapse;margin-top:8px;background:var(--card-bg);border-radius:var(--radius,14px);overflow:hidden}
    .offers-table thead th{background:var(--tag-bg);color:var(--text-secondary);font-size:12px;text-transform:uppercase;letter-spacing:.5px}
    .offers-table th,.offers-table td,.spec-table td{padding:12px;border-bottom:1px solid var(--border-color);text-align:left;color:var(--text-primary)}
    .offers-table .price{font-weight:800;white-space:nowrap}
    .go-btn{display:inline-block;background:var(--accent-grad);color:#fff;padding:8px 18px;border-radius:8px;text-decoration:none;font-size:13px;font-weight:700;box-shadow:0 4px 12px rgba(55,145,0,.25);transition:filter .2s ease}
    .go-btn:hover{filter:brightness(1.06);color:#fff}
    .spec-table .spec-group td{font-weight:800;background:var(--tag-bg);color:var(--text-primary);text-transform:uppercase;font-size:12px;letter-spacing:.5px}
    .spec-table .spec-name{color:var(--text-secondary);width:40%}
    @@media (max-width:768px){.product-image{width:100%}}
</style>
