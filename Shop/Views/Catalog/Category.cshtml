@model Shop.ViewModels.CatalogPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
}

<div class="catalog-page">
    <div class="catalog-header">
        <h1>@Model.Title <small>@Model.Products.Count модел(и/ей)</small></h1>
        <div class="catalog-controls">
            <form method="get" class="sort-form">
                <label>Выводить</label>
                <select name="sort" onchange="this.form.submit()">
                    <option value="popularity" selected="@(Model.Sort != "price")">по популярности</option>
                    <option value="price" selected="@(Model.Sort == "price")">по цене</option>
                </select>
            </form>
        </div>
    </div>

    <div class="catalog-body">
        <div class="catalog-list">
            @if (Model.Products.Any())
            {
                foreach (var p in Model.Products)
                {
                    var offers = p.Offers.OrderBy(o => o.Price).ToList();
                    <div class="catalog-item">
                        <div class="thumb">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/placeholder-phone-1.png" : p.ImageUrl)" alt="@p.Name">
                        </div>
                        <div class="main">
                            <h2>
                                <a asp-controller="Catalog" asp-action="Product" asp-route-id="@p.Id">@p.Name</a>
                                @if (!string.IsNullOrEmpty(p.Brand)) { <small>@p.Brand</small> }
                            </h2>

                            <div class="tags">
                                @if (p.Year.HasValue) { <span>@p.Year год</span> }
                                @if (!string.IsNullOrEmpty(p.Tags))
                                {
                                    foreach (var t in p.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span>@t.Trim()</span>
                                    }
                                }
                            </div>

                            <div class="specs">
                                @foreach (var s in p.Specifications.Take(5))
                                {
                                    <p>@s.Name: @s.Value</p>
                                }
                            </div>

                            <div class="actions">
                                <label><input type="checkbox" /> Сравнить</label>
                            </div>
                        </div>

                        <div class="offers">
                            <div class="price-range">
                                @if (p.PriceMin.HasValue)
                                {
                                    <text>от <b>@p.PriceMin.Value.ToString("N0")</b></text>
                                }
                                @if (p.PriceMax.HasValue && p.PriceMax != p.PriceMin)
                                {
                                    <text> до <b>@p.PriceMax.Value.ToString("N0")</b></text>
                                }
                                <span class="cur">грн</span>
                            </div>
                            <ul class="offer-list">
                                @if (offers.Any())
                                {
                                    foreach (var o in offers)
                                    {
                                        <li>
                                            <a href="@o.ProductUrl" target="_blank" rel="noopener nofollow">@o.Store?.Name</a>
                                            <span class="offer-price">@o.Price.ToString("N0") грн</span>
                                            @if (!o.InStock) { <span class="out">нет в наличии</span> }
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li>— предложений пока нет</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert">В этой категории пока нет моделей. Данные добавит парсер или администратор.</div>
            }
        </div>

        <aside class="catalog-filters">
            <div class="filter-block">
                <h3>ПОДБОР ПО ПАРАМЕТРАМ</h3>
                <input type="search" placeholder="Поиск параметров" />
                <div class="filter-row">
                    <label>Цена</label>
                    <input type="number" placeholder="от" /> - <input type="number" placeholder="до" />
                </div>
                <p class="filter-note">Фильтры появятся в следующей версии.</p>
            </div>
        </aside>
    </div>
</div>

<style>
    .catalog-page{padding:20px}
    .catalog-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
    .catalog-header h1{margin:0;color:var(--accent, #3650a6)}
    .catalog-header h1 small{font-size:14px;color:#888;font-weight:400}
    .sort-form{display:flex;align-items:center;gap:8px}
    .catalog-body{display:flex;gap:20px;margin-top:20px;align-items:flex-start}
    .catalog-list{flex:1;display:flex;flex-direction:column;gap:16px;min-width:0}
    .catalog-item{display:flex;gap:16px;padding:16px;border-radius:8px;border:1px solid var(--border,#eee);background:var(--card-bg,#fff)}
    .catalog-item .thumb{width:150px;flex-shrink:0}
    .catalog-item .thumb img{width:100%;border-radius:8px}
    .catalog-item .main{flex:1;min-width:0}
    .catalog-item .main h2{margin:0;font-size:20px}
    .catalog-item .main h2 a{color:var(--link,#2b4b85);text-decoration:none}
    .catalog-item .main h2 small{font-size:13px;color:#888}
    .catalog-item .tags span{display:inline-block;background:var(--tag-bg,#f3f6fb);padding:4px 8px;border-radius:12px;margin:6px 6px 0 0;font-size:12px}
    .catalog-item .specs{color:#777;margin-top:8px;font-size:13px}
    .catalog-item .specs p{margin:2px 0}
    .catalog-item .actions{margin-top:8px}
    .catalog-item .offers{width:240px;flex-shrink:0;text-align:right}
    .catalog-item .offers .price-range{color:#d9534f;font-weight:600;font-size:18px}
    .catalog-item .offers .cur{font-size:13px;font-weight:400}
    .offer-list{list-style:none;padding:0;margin:10px 0 0;font-size:13px}
    .offer-list li{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-top:1px dashed var(--border,#eee)}
    .offer-list a{color:var(--link,#2b4b85);text-decoration:none}
    .offer-price{font-weight:600}
    .offer-list .out{color:#aaa}
    aside.catalog-filters{width:280px;flex-shrink:0}
    .filter-block{background:var(--filter-bg,#fff8e6);padding:12px;border-radius:6px;border:1px solid var(--border,#f0dcb0)}
    .filter-note{font-size:12px;color:#999;margin-top:10px}
</style>
