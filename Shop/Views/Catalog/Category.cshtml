@model Shop.ViewModels.CatalogPageViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
    var f = Model.Filter;
    // slug из маршрута для сохранения action при отправке GET-форм
    var action = (string?)ViewContext.RouteData.Values["action"] ?? "Category";
}

<div class="catalog-page">
    <div class="catalog-header">
        <h1>@Model.Title <small>@Model.Products.Count модел(и/ей)</small></h1>
        <div class="catalog-controls">
            <form method="get" class="sort-form">
                @if (action == "Category") { <input type="hidden" name="slug" value="@Model.Slug" /> }
                <input type="hidden" name="Brand" value="@f.Brand" />
                <input type="hidden" name="PriceMin" value="@f.PriceMin" />
                <input type="hidden" name="PriceMax" value="@f.PriceMax" />
                <label>Выводить</label>
                <select name="Sort" onchange="this.form.submit()">
                    <option value="popularity" selected="@(string.IsNullOrEmpty(f.Sort) || f.Sort == "popularity")">по популярности</option>
                    <option value="price" selected="@(f.Sort == "price")">сначала дешёвые</option>
                    <option value="price_desc" selected="@(f.Sort == "price_desc")">сначала дорогие</option>
                    <option value="name" selected="@(f.Sort == "name")">по названию</option>
                </select>
            </form>
        </div>
    </div>

    <div class="catalog-body">
        <div class="catalog-list">
            @if (Model.Products.Any())
            {
                foreach (var p in Model.Products)
                {
                    var offers = p.Offers.OrderBy(o => o.Price).ToList();
                    <div class="catalog-item">
                        <div class="thumb">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/placeholder-phone-1.png" : p.ImageUrl)" alt="@p.Name">
                        </div>
                        <div class="main">
                            <h2>
                                <a asp-controller="Catalog" asp-action="Product" asp-route-id="@p.Id">@p.Name</a>
                                @if (!string.IsNullOrEmpty(p.Brand)) { <small>@p.Brand</small> }
                            </h2>

                            <div class="tags">
                                @if (p.Year.HasValue) { <span>@p.Year год</span> }
                                @if (!string.IsNullOrEmpty(p.Tags))
                                {
                                    foreach (var t in p.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span>@t.Trim()</span>
                                    }
                                }
                            </div>

                            <div class="specs">
                                @foreach (var s in p.Specifications.Take(5))
                                {
                                    <p>@s.Name: @s.Value</p>
                                }
                            </div>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                var isFav = Model.FavoriteIds.Contains(p.Id);
                                <form asp-controller="Cabinet" asp-action="ToggleFavorite" method="post" class="fav-form">
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                    <button type="submit" class="fav-btn @(isFav ? "on" : "")" title="@(isFav ? "В избранном" : "В избранное")">
                                        @(isFav ? "♥" : "♡") @(isFav ? "В избранном" : "В избранное")
                                    </button>
                                </form>
                            }
                        </div>

                        <div class="offers">
                            <div class="price-range">
                                @if (p.PriceMin.HasValue)
                                {
                                    <text>от <b>@p.PriceMin.Value.ToString("N0")</b></text>
                                }
                                @if (p.PriceMax.HasValue && p.PriceMax != p.PriceMin)
                                {
                                    <text> до <b>@p.PriceMax.Value.ToString("N0")</b></text>
                                }
                                <span class="cur">грн</span>
                            </div>
                            <ul class="offer-list">
                                @if (offers.Any())
                                {
                                    foreach (var o in offers)
                                    {
                                        <li>
                                            <a href="@o.ProductUrl" target="_blank" rel="noopener nofollow">@o.Store?.Name</a>
                                            <span class="offer-price">@o.Price.ToString("N0") грн</span>
                                            @if (!o.InStock) { <span class="out">нет в наличии</span> }
                                        </li>
                                    }
                                }
                                else
                                {
                                    <li>— предложений пока нет</li>
                                }
                            </ul>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert">По заданным условиям моделей не найдено.</div>
            }
        </div>

        <aside class="catalog-filters">
            <form method="get" class="filter-block">
                @if (action == "Category") { <input type="hidden" name="slug" value="@Model.Slug" /> }
                <input type="hidden" name="Sort" value="@f.Sort" />
                <h3>ПОДБОР ПО ПАРАМЕТРАМ</h3>

                <div class="filter-row">
                    <label>Цена, грн</label>
                    <div class="price-inputs">
                        <input type="number" name="PriceMin" value="@f.PriceMin" placeholder="от" />
                        <span>—</span>
                        <input type="number" name="PriceMax" value="@f.PriceMax" placeholder="до" />
                    </div>
                </div>

                @if (Model.Brands.Any())
                {
                    <div class="filter-group">
                        <h4>Производитель</h4>
                        <label class="brand-opt">
                            <input type="radio" name="Brand" value="" checked="@string.IsNullOrEmpty(f.Brand)" /> Все
                        </label>
                        @foreach (var b in Model.Brands)
                        {
                            <label class="brand-opt">
                                <input type="radio" name="Brand" value="@b" checked="@(f.Brand == b)" /> @b
                            </label>
                        }
                    </div>
                }

                <button type="submit" class="apply-btn">Применить</button>
                <a class="reset-link" asp-action="@action" asp-route-slug="@(action == "Category" ? Model.Slug : null)">Сбросить</a>
            </form>
        </aside>
    </div>
</div>

<style>
    .catalog-page{padding:20px}
    .catalog-header{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
    .catalog-header h1{margin:0;color:var(--accent, #3650a6)}
    .catalog-header h1 small{font-size:14px;color:#888;font-weight:400}
    .sort-form{display:flex;align-items:center;gap:8px}
    .sort-form select{padding:6px 10px;border-radius:6px;border:1px solid var(--border,#ccc)}
    .catalog-body{display:flex;gap:20px;margin-top:20px;align-items:flex-start}
    .catalog-list{flex:1;display:flex;flex-direction:column;gap:16px;min-width:0}
    .catalog-item{display:flex;gap:16px;padding:16px;border-radius:8px;border:1px solid var(--border,#eee);background:var(--card-bg,#fff)}
    .catalog-item .thumb{width:150px;flex-shrink:0}
    .catalog-item .thumb img{width:100%;border-radius:8px}
    .catalog-item .main{flex:1;min-width:0}
    .catalog-item .main h2{margin:0;font-size:20px}
    .catalog-item .main h2 a{color:var(--link,#2b4b85);text-decoration:none}
    .catalog-item .main h2 small{font-size:13px;color:#888}
    .catalog-item .tags span{display:inline-block;background:var(--tag-bg,#f3f6fb);padding:4px 8px;border-radius:12px;margin:6px 6px 0 0;font-size:12px}
    .catalog-item .specs{color:#777;margin-top:8px;font-size:13px}
    .catalog-item .specs p{margin:2px 0}
    .catalog-item .offers{width:240px;flex-shrink:0;text-align:right}
    .catalog-item .offers .price-range{color:#d9534f;font-weight:600;font-size:18px}
    .catalog-item .offers .cur{font-size:13px;font-weight:400}
    .offer-list{list-style:none;padding:0;margin:10px 0 0;font-size:13px}
    .offer-list li{display:flex;justify-content:space-between;gap:8px;padding:3px 0;border-top:1px dashed var(--border,#eee)}
    .offer-list a{color:var(--link,#2b4b85);text-decoration:none}
    .offer-price{font-weight:600}
    .offer-list .out{color:#aaa}
    aside.catalog-filters{width:280px;flex-shrink:0}
    .filter-block{background:var(--filter-bg,#fff8e6);padding:14px;border-radius:6px;border:1px solid var(--border,#f0dcb0)}
    .filter-block h3{font-size:14px;margin:0 0 12px}
    .filter-row label{font-size:13px;font-weight:600;display:block;margin-bottom:6px}
    .price-inputs{display:flex;align-items:center;gap:6px}
    .price-inputs input{width:80px;padding:5px 8px;border-radius:5px;border:1px solid var(--border,#ccc)}
    .filter-group{margin-top:14px}
    .filter-group h4{font-size:13px;margin:0 0 8px}
    .brand-opt{display:block;font-size:14px;margin:4px 0;cursor:pointer}
    .apply-btn{margin-top:14px;width:100%;padding:8px;border:none;border-radius:6px;background:var(--accent,#3650a6);color:#fff;cursor:pointer}
    .reset-link{display:block;text-align:center;margin-top:8px;font-size:13px;color:#888}
    .fav-form{margin-top:10px}
    .fav-btn{background:none;border:1px solid var(--border,#ddd);border-radius:16px;padding:4px 12px;font-size:13px;cursor:pointer;color:#666}
    .fav-btn.on{color:#d9534f;border-color:#d9534f}
    .fav-btn:hover{border-color:#d9534f;color:#d9534f}
</style>
