@model IEnumerable<Shop.Domain.Entities.Phone>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Мобильные телефоны";
}

<div class="catalog-page">
    <div class="catalog-header">
        <h1>Мобильные телефоны <small>цены на ~1771 модель</small></h1>
        <div class="catalog-controls">
            <label>Выводить</label>
            <select>
                <option>по популярности</option>
                <option>по цене</option>
            </select>
            <label class="with-checkbox"><input type="checkbox" checked/> с доставкой по Украине</label>
        </div>
    </div>

    <div class="catalog-body">
        <div class="catalog-list">
            @if (Model != null && Model.Any())
            {
                foreach (var p in Model)
                {
                    <div class="catalog-item">
                        <div class="thumb"><img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/placeholder-phone-1.png" : p.ImageUrl)" alt="@p.Name"></div>
                        <div class="main">
                            <h2>@p.Name <small>@p.Storage @(string.IsNullOrEmpty(p.Ram) ? "" : "/ " + p.Ram)</small></h2>

                            <div class="tags">
                                @if (p.Year.HasValue) { <span>@p.Year.Value год</span> }
                                @if (!string.IsNullOrEmpty(p.Tags))
                                {
                                    foreach (var t in p.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span>@t.Trim()</span>
                                    }
                                }
                            </div>

                            <div class="specs">
                                @if(!string.IsNullOrEmpty(p.Screen)) { <p>Экран: @p.Screen</p> }
                                @if(!string.IsNullOrEmpty(p.Camera)) { <p>Камера: @p.Camera</p> }
                                @if(!string.IsNullOrEmpty(p.Battery)) { <p>Аккумулятор: @p.Battery</p> }
                            </div>

                            <div class="actions">
                                <label><input type="checkbox"/> Сравнить</label>
                            </div>
                        </div>

                        <div class="offers">
                            <div class="price-range">@((p.PriceMin.HasValue ? ("от <b>" + p.PriceMin.Value.ToString("N0")) : "")) @((p.PriceMax.HasValue ? (" до <b>" + p.PriceMax.Value.ToString("N0") + "</b> грн") : ""))</div>
                            <ul>
                                <li>— данные продавцов будут загружаться отдельно</li>
                            </ul>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert">Нет доступных моделей.</div>
            }
        </div>

        <aside class="catalog-filters">
            <div class="filter-block">
                <h3>ПОДБОР ПО ПАРАМЕТРАМ</h3>
                <input type="search" placeholder="Поиск параметров" />
                <div class="filter-row">
                    <label>Цена</label>
                    <input type="number" placeholder="от" /> - <input type="number" placeholder="до" />
                </div>

                <div class="filter-group">
                    <h4>Производители</h4>
                    <label><input type="checkbox"/> Apple</label>
                    <label><input type="checkbox"/> Samsung</label>
                    <label><input type="checkbox"/> Xiaomi</label>
                </div>
            </div>
        </aside>
    </div>
</div>

<style>
    .catalog-page{padding:20px}
    .catalog-header{display:flex;align-items:center;justify-content:space-between}
    .catalog-header h1{margin:0;color:#3650a6}
    .catalog-body{display:flex;gap:20px;margin-top:20px}
    .catalog-list{flex:1;display:flex;flex-direction:column;gap:16px}
    .catalog-item{display:flex;gap:16px;padding:16px;border-radius:8px;border:1px solid #eee;background:#fff}
    .catalog-item .thumb{width:150px}
    .catalog-item .thumb img{width:100%;border-radius:8px}
    .catalog-item .main{flex:1}
    .catalog-item .main h2{margin:0;color:#2b4b85}
    .catalog-item .tags span{display:inline-block;background:#f3f6fb;padding:4px 8px;border-radius:12px;margin:6px 6px 6px 0;font-size:12px}
    .catalog-item .specs{color:#555;margin-top:8px}
    .catalog-item .offers{width:240px;text-align:right}
    .catalog-item .offers .price-range{color:#d9534f;font-weight:600}
    aside.catalog-filters{width:280px}
    .filter-block{background:#fff8e6;padding:12px;border-radius:6px;border:1px solid #f0dcb0}
</style>
