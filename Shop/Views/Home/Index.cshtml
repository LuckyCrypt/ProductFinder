@model IEnumerable<Shop.Domain.Entities.Product>

<div class="marketplace-wrapper">

    <!-- ГЕРОЙ-БАННЕР -->
    <section class="mp-hero">
        <button class="mp-hero__arrow mp-hero__arrow--left" type="button" aria-label="Назад">‹</button>
        <div class="mp-hero__content">
            <span class="mp-hero__eyebrow">Добро пожаловать в</span>
            <h1 class="mp-hero__title">LUCKYCATALOG</h1>
            <p class="mp-hero__subtitle">Техника без компромиссов — для тех, кто выбирает лучшее</p>
        </div>
        <button class="mp-hero__arrow mp-hero__arrow--right" type="button" aria-label="Вперёд">›</button>
        <div class="mp-hero__dots">
            <span class="mp-dot active"></span>
            <span class="mp-dot"></span>
            <span class="mp-dot"></span>
        </div>
    </section>

    <!-- РЯД КАТЕГОРИЙ -->
    <nav class="wlx-cats mp-cats">
        <a class="wlx-cat" href='@Url.Action("Appliances", "Catalog")'>
            <span class="wlx-cat__icon">🧺</span>
            <span class="wlx-cat__label">Стиральные машины</span>
        </a>
        <a class="wlx-cat" href='@Url.Action("Gadgets", "Catalog")'>
            <span class="wlx-cat__icon">⌚</span>
            <span class="wlx-cat__label">Наручные часы</span>
        </a>
        <a class="wlx-cat" href='@Url.Action("Phones", "Catalog")'>
            <span class="wlx-cat__icon">📱</span>
            <span class="wlx-cat__label">Смартфоны</span>
        </a>
        <a class="wlx-cat" href='@Url.Action("Computers", "Catalog")'>
            <span class="wlx-cat__icon">💻</span>
            <span class="wlx-cat__label">Компьютерная техника</span>
        </a>
    </nav>

    <!-- ДОПОЛНИТЕЛЬНЫЕ БАННЕРЫ -->
    <div class="mp-sub">
        <div class="mp-sub__card"><span class="mp-sub__icon">🎥</span><span>Видео-регистраторы</span></div>
        <div class="mp-sub__card"><span class="mp-sub__icon">📶</span><span>Wi-Fi доступ по всему дому</span></div>
        <div class="mp-sub__card"><span class="mp-sub__icon">📲</span><span>Планшеты</span></div>
        <div class="mp-sub__card"><span class="mp-sub__icon">🧩</span><span>Конструкторы для всех возрастов</span></div>
    </div>

    <!-- ПОПУЛЯРНЫЕ МОДЕЛИ -->
    <h2 class="wlx-heading mp-section-title">Популярные модели</h2>
    <div class="wlx-grid">
        @if (Model != null && Model.Any())
        {
            foreach (var p in Model)
            {
                var hasSpread = p.PriceMax.HasValue && p.PriceMin.HasValue && p.PriceMax.Value > p.PriceMin.Value;
                <a class="wlx-card" href='@Url.Action("Product", "Catalog", new { id = p.Id })'>
                    <div class="wlx-card__badges">
                        @if (p.Offers != null && p.Offers.Count > 2)
                        {
                            <span class="wlx-badge wlx-badge--hit">Хит</span>
                        }
                        @if (hasSpread)
                        {
                            <span class="wlx-badge wlx-badge--sale">Скидка</span>
                        }
                    </div>
                    <div class="wlx-card__media">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/img/placeholder-phone-1.png" : p.ImageUrl)" alt="@p.Name">
                    </div>
                    <div class="wlx-card__body">
                        <div class="wlx-card__title">@p.Name</div>
                        @if (p.PriceMin.HasValue)
                        {
                            <div>
                                <span class="wlx-price">от @p.PriceMin.Value.ToString("N0") ₽</span>
                                @if (hasSpread)
                                {
                                    <span class="wlx-price--old">@p.PriceMax!.Value.ToString("N0") ₽</span>
                                }
                            </div>
                        }
                        <div class="mp-card__offers">@(p.Offers?.Count ?? 0) предл.</div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="wlx-panel">Нет данных</div>
        }
    </div>
</div>

<style>
    .marketplace-wrapper { width: 100%; }
    .marketplace-wrapper * { box-sizing: border-box; }

    /* Герой */
    .mp-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 320px;
        padding: 40px 70px;
        margin-bottom: 8px;
        border-radius: 20px;
        text-align: center;
        color: #fff;
        background: radial-gradient(120% 140% at 50% 0%, #24303a 0%, var(--bg-accent, #1e2227) 55%, #0f1316 100%);
        overflow: hidden;
    }

    .mp-hero__content { position: relative; z-index: 2; }

    .mp-hero__eyebrow {
        display: inline-block;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #fff;
        background: var(--accent-grad, linear-gradient(135deg,#205300,#379100 55%,#44b300));
        padding: 8px 22px;
        border-radius: 8px;
        margin-bottom: 18px;
    }

    .mp-hero__title {
        font-size: clamp(38px, 6vw, 72px);
        font-weight: 800;
        letter-spacing: 2px;
        line-height: 1;
        margin: 0 0 16px;
    }

    .mp-hero__subtitle { font-size: 16px; color: #c8ccd0; margin: 0; }

    .mp-hero__arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 2;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: rgba(255,255,255,0.08);
        color: #fff;
        font-size: 24px;
        line-height: 1;
        cursor: pointer;
        transition: background 0.2s ease;
    }
        .mp-hero__arrow:hover { background: rgba(255,255,255,0.18); }
        .mp-hero__arrow--left { left: 18px; }
        .mp-hero__arrow--right { right: 18px; }

    .mp-hero__dots {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        z-index: 2;
    }
    .mp-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(255,255,255,0.3); }
    .mp-dot.active { background: var(--accent-2, #44b300); width: 22px; border-radius: 4px; }

    /* Ряд категорий */
    .mp-cats {
        border-top: 1px solid var(--border-color, #ececec);
        border-bottom: 1px solid var(--border-color, #ececec);
        margin-bottom: 28px;
    }

    /* Доп. баннеры */
    .mp-sub {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 40px;
    }
    .mp-sub__card {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 92px;
        padding: 18px 20px;
        border-radius: 14px;
        background: linear-gradient(180deg, var(--card-grad-b, #fafafa), var(--card-grad-a, #f5f5f5));
        border: 1px solid var(--border-color, #ececec);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary, #555);
    }
    .mp-sub__icon { font-size: 26px; }

    .mp-section-title { margin-bottom: 20px; }
    .mp-card__offers { font-size: 12px; color: var(--text-muted, #979797); }

    @@media (max-width: 768px) {
        .mp-hero { min-height: 220px; padding: 30px 50px; }
        .mp-sub { grid-template-columns: repeat(2, 1fr); }
    }
</style>
