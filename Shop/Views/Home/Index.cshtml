@{
    ViewData["Title"] = "Каталог техники";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
</head>
<body>

    <!-- Шапка сайта -->
    <header>
        <div class="header-content">
            <div class="logo">TechCatalog</div>
            <div class="search">
                <input type="text" placeholder="Поиск по товарам...">
            </div>
            <div class="cart">🛒 Корзина (0)</div>
        </div>
    </header>

    <div class="container">
        <!-- Боковая панель с фильтрами -->
        <aside class="sidebar">
            <h3>Фильтры</h3>

            <div class="filter-group">
                <h4>Цена</h4>
                <input type="range" min="0" max="1000000" value="500000">
                <div>до <strong>500 000 ₸</strong></div>
            </div>

            <div class="filter-group">
                <h4>Бренды</h4>
                <label><input type="checkbox"> Samsung</label>
                <label><input type="checkbox"> Apple</label>
                <label><input type="checkbox"> Xiaomi</label>
                <label><input type="checkbox"> Huawei</label>
            </div>

            <div class="filter-group">
                <h4>Категории</h4>
                <label><input type="checkbox"> Смартфоны</label>
                <label><input type="checkbox"> Ноутбуки</label>
                <label><input type="checkbox"> Телевизоры</label>
                <label><input type="checkbox"> Наушники</label>
            </div>
        </aside>

        <!-- Основной контент: товары -->
        <main class="content">
            <h2>Смартфоны</h2>
            <div class="products-grid">
                <!-- Пример карточки товара -->
                <div class="product-card">
                    <div class="product-img">
                        <img src="" alt="Товар 1">
                    </div>
                    <div class="product-info">
                        <div class="product-title">Samsung Galaxy S23</div>
                        <div class="product-price">450</div>
                    </div>
                </div>

                <div class="product-card">
                    <div class="product-img">
                        <img src="" alt="Товар 2">
                    </div>
                    <div class="product-info">
                        <div class="product-title">iPhone 15 Pro</div>
                        <div class="product-price">890</div>
                    </div>
                </div>

                <div class="product-card">
                    <div class="product-img">
                        <img src="" alt="Товар 3">
                    </div>
                    <div class="product-info">
                        <div class="product-title">Xiaomi Redmi Note</div>
                        <div class="product-price">220 </div>
                    </div>
                </div>

                <div class="product-card">
                    <div class="product-img">
                        <img src="" alt="Товар 4">
                    </div>
                    <div class="product-info">
                        <div class="product-title">Huawei P60</div>
                        <div class="product-price">380</div>
                    </div>
                </div>
            </div>

            <!-- Пагинация -->
            <div class="pagination">
                <a href="#" class="active">1</a>
                <a href="#">2</a>
                <a href="#">3</a>
                <a href="#">→</a>
            </div>
        </main>
    </div>

    <!-- Подвал -->
    <footer>
        &copy; 2025 TechCatalog — Каталог электроники Казахстана
    </footer>

</body>
</html>