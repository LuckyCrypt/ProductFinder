@model IEnumerable<Shop.ViewModels.RentApartViewModel>

@{
    ViewData["Title"] = "Все Товары";
}
<h1 class="mb-4">Наши Товары</h1>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var product in Model)
        {
            <div class="col-sm-6 col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 180px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text text-muted flex-grow-1">@product.Description.Substring(0, Math.Min(product.Description.Length, 50))...</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <span class="fs-5 fw-bold">@product.Price.ToString("C")</span>
                            <div>
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">Подробнее</a>
                                <!-- Точка для контроллера: добавить товар в корзину -->
                                <button type="button" class="btn btn-success btn-sm ms-2" onclick="addToCart(@product.Id)">
                                    <i class="fas fa-cart-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="alert alert-warning">К сожалению, товары пока отсутствуют.</p>
        </div>
    }
</div>

@section Scripts {
    <script>
        function addToCart(productId) {
            alert('Товар с ID ' + productId + ' будет добавлен в корзину через Controller.');
            // Аналогично Home/Index, здесь будет AJAX-запрос
        }
    </script>
}
