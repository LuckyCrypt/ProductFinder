@model List<Shop.Domain.Entities.Category>

<nav class="catalog-menu">
    @foreach (var c in Model)
    {
        <div class="cm-item">
            <a asp-controller="Catalog" asp-action="Category" asp-route-slug="@c.Slug">
                @c.IconOrImage @c.Name
            </a>
            @if (c.Children.Any())
            {
                <div class="cm-sub">
                    @foreach (var ch in c.Children.OrderBy(x => x.Name))
                    {
                        <a asp-controller="Catalog" asp-action="Category" asp-route-slug="@ch.Slug">@ch.Name</a>
                    }
                </div>
            }
        </div>
    }
</nav>

<style>
    .catalog-menu{display:flex;gap:4px;flex-wrap:wrap;justify-content:center;padding:10px 16px;border-bottom:1px solid var(--border-color,#ececec);background:var(--bg-primary,#fff)}
    .catalog-menu .cm-item{position:relative}
    .catalog-menu .cm-item > a{display:block;padding:9px 16px;border-radius:8px;color:var(--text-primary,#191919);text-decoration:none;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;transition:all .2s ease}
    .catalog-menu .cm-item > a:hover{background:var(--tag-bg,#f0f2f4);color:var(--accent,#379100)}
    .catalog-menu .cm-sub{display:none;position:absolute;top:100%;left:0;background:var(--card-bg,#fff);border:1px solid var(--border-color,#ececec);border-radius:10px;min-width:200px;box-shadow:var(--shadow-deep,0 8px 30px rgba(0,0,0,.12));z-index:1100;padding:8px 0}
    .catalog-menu .cm-item:hover .cm-sub{display:block}
    .catalog-menu .cm-sub a{display:block;padding:9px 16px;color:var(--text-secondary,#555);text-decoration:none;font-size:13px;font-weight:500;text-transform:none;letter-spacing:0}
    .catalog-menu .cm-sub a:hover{background:var(--tag-bg,#f0f2f4);color:var(--accent,#379100)}
</style>
