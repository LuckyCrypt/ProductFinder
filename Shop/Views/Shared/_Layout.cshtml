<!DOCTYPE html>
<html lang="ru" id="pageRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LuckyCatalog</title>

    <!-- Шрифт WidLanex -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Style.css" />
    <link rel="stylesheet" href="~/css/widlanex.css" />
</head>
<body>
    <header class="header" id="mainHeader">
        <a href="/" class="logo">LuckyCatalog</a>

        <button class="catalog-btn">📁 Каталог</button>

        <div class="search-container">
            <span class="search-icon">🔍</span>
            <input type="text" class="search-input" placeholder="Поиск товаров...">
        </div>
        <!-- 🌓 КНОПКА ПЕРЕКЛЮЧЕНИЯ ТЕМЫ -->
        <button class="theme-switcher" id="themeToggle" aria-label="Переключить тему">
            <i class="fas fa-sun"></i>
        </button>

        <div class="header-icons">
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="icon-link">
                    <span class="icon">🛠️</span>
                    <span>Админ</span>
                </a>
            }
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Cabinet" asp-action="Index" class="icon-link">
                    <span class="icon">👤</span>
                    <span>@(User.Identity.Name)</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form" style="display:inline">
                    <button type="submit" class="icon-link logout-btn" title="Выйти"
                            style="background:none;border:none;cursor:pointer;font:inherit;color:inherit;padding:0">
                        <span class="icon">🚪</span>
                        <span>Выйти</span>
                    </button>
                </form>
            }
            else
            {
                <a href="/account" class="icon-link">
                    <span class="icon">👤</span>
                    <span>Личный кабинет</span>
                </a>
            }
        </div>
    </header>

    @await Component.InvokeAsync("CatalogMenu")

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            &copy; @DateTime.Now.Year - LuckyCatalog
        </div>
    </footer>
    <script src="~/js/site.js"></script>
    <!-- Bootstrap JS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

    <!-- View-specific scripts -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
