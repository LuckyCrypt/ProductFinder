@model Shop.Areas.Admin.Models.StoreFormModel
@{ ViewData["Title"] = "Магазин"; }

<h1>Изменить магазин</h1>

<div class="card-form">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SiteUrl" class="form-label"></label>
            <input asp-for="SiteUrl" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="LogoUrl" class="form-label"></label>
            <input asp-for="LogoUrl" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Сохранить</button>
        <a class="btn btn-link" asp-action="Index">Отмена</a>
    </form>
</div>
