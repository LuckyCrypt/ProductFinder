@model List<Shop.Domain.Entities.Product>
@{ ViewData["Title"] = "Товары"; }

<div class="topbar">
    <h1>Товары</h1>
    <a class="btn btn-primary" asp-action="Create">+ Товар</a>
</div>

<table class="grid">
    <thead>
        <tr><th>Название</th><th>Бренд</th><th>Категория</th><th>Офферы</th><th>Цена, грн</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Name</td>
            <td>@p.Brand</td>
            <td>@(p.Category?.Name ?? "—")</td>
            <td>@p.Offers.Count</td>
            <td>@(p.PriceMin?.ToString("N0") ?? "—")@(p.PriceMax.HasValue && p.PriceMax != p.PriceMin ? " … " + p.PriceMax.Value.ToString("N0") : "")</td>
            <td>
                <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@p.Id">Изм.</a>
                <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline"
                      onsubmit="return confirm('Удалить товар со всеми офферами?');">
                    <button class="btn btn-outline-danger btn-sm" type="submit">Удл.</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
