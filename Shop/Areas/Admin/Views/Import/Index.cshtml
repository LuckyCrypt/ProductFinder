@model List<PriceTargetRow>
@{
    ViewData["Title"] = "Импорт цен";
}

<div class="topbar">
    <h1>Импорт цен с маркетплейсов</h1>
    <form asp-action="RefreshAll" method="post">
        <button type="submit" class="btn btn-primary">Обновить все цены</button>
    </form>
</div>

<p style="color:#555;margin-bottom:16px;max-width:820px">
    Парсер собирает цены по офферам, у которых магазин — маркетплейс (Wildberries, Ozon,
    Яндекс.Маркет) и указана ссылка на карточку. Привязать ссылку можно на странице товара
    (раздел «Офферы»). Сбор идёт в фоне; статус обновляется здесь.
</p>

@if (!Model.Any())
{
    <div class="card-form">
        Пока нет ни одной цели для парсинга. Откройте товар в разделе
        <a asp-controller="Products" asp-action="Index">Товары</a>, добавьте оффер с магазином
        Wildberries / Ozon / Яндекс.Маркет и ссылкой на карточку — затем вернитесь сюда.
    </div>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th>Товар</th>
                <th>Маркетплейс</th>
                <th>Цена, ₽</th>
                <th>Наличие</th>
                <th>Проверено</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-controller="Products" asp-action="Edit" asp-route-id="@r.ProductId">@r.ProductName</a></td>
                    <td>@r.StoreName</td>
                    <td>@(r.Price > 0 ? r.Price.ToString("N0") : "—")</td>
                    <td>@(r.InStock ? "в наличии" : "нет")</td>
                    <td>@(r.LastCheckedAt == default ? "—" : r.LastCheckedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</td>
                    <td>
                        @{
                            var status = string.IsNullOrEmpty(r.LastStatus) ? "—" : r.LastStatus;
                            var color = status switch
                            {
                                "Ok" => "#379100",
                                "Captcha" or "Blocked" => "#ee7a00",
                                "Error" or "NotFound" => "#ee0000",
                                _ => "#979797"
                            };
                        }
                        <span style="font-weight:700;color:@color">@status</span>
                        @if (!string.IsNullOrEmpty(r.LastError))
                        {
                            <div style="font-size:12px;color:#979797" title="@r.LastError">@(r.LastError.Length > 60 ? r.LastError.Substring(0, 60) + "…" : r.LastError)</div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
